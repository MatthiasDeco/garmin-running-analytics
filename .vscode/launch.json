{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {"name": "[Dev] main_garmin_running_analytics",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/ETL_from_garmin/main_ETL_from_garmin.py",
        "python": "${workspaceFolder}/.venv/Scripts/python.exe",
        "console": "integratedTerminal",
        "args": ["dev"],
        "env": {
            "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
        "name": "[Prod] main_garmin_running_analytics",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/ETL_from_garmin/main_ETL_from_garmin.py",
        "python": "${workspaceFolder}/.venv/Scripts/python.exe",
        "console": "integratedTerminal",
        "args": ["prod"],
        "env": {
            "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
        "name": "[Dev] main_clustering",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/Clustering/main_clustering.py",
        "python": "${workspaceFolder}/.venv/Scripts/python.exe",
        "console": "integratedTerminal",
        "args": ["dev"],
        "env": {
            "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {"name": "[Prod] main_clustering",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/Clustering/main_clustering.py",
        "python": "${workspaceFolder}/.venv/Scripts/python.exe",
        "console": "integratedTerminal",
        "args": ["prod"],
        "env": {
            "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}